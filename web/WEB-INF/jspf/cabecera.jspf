<%--
    cabecera.jspf - Encabezado HTML + barra de navegacion Bootstrap 5.
    La pagina debe definir antes la variable tituloPagina (c:set) y haber
    incluido conexion.jspf (que define "ctx").
--%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${tituloPagina}"/> | Trabajos de Grado UTS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="${ctx}/css/estilos.css" rel="stylesheet">
</head>
<body class="bg-light">
<c:set var="esEstudiante" value="${fn:contains(sessionScope.roles, 'ESTUDIANTE')}"/>
<c:set var="esDocente"    value="${fn:contains(sessionScope.roles, 'DOCENTE')}"/>
<c:set var="esComite"     value="${fn:contains(sessionScope.roles, 'COMITE')}"/>
<c:set var="esAdmin"      value="${fn:contains(sessionScope.roles, 'ADMINISTRADOR')}"/>
<nav class="navbar navbar-expand-lg navbar-dark shadow-sm barra-uts">
  <div class="container">
    <a class="navbar-brand fw-bold" href="${ctx}/index.jsp">
      <i class="bi bi-mortarboard-fill"></i> Trabajos de Grado UTS
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="${ctx}/banco_ideas.jsp"><i class="bi bi-lightbulb"></i> Banco de ideas</a></li>
        <c:if test="${not empty sessionScope.idUsuario}">
          <li class="nav-item"><a class="nav-link" href="${ctx}/calendario.jsp"><i class="bi bi-calendar-event"></i> Calendario</a></li>
          <li class="nav-item"><a class="nav-link" href="${ctx}/formatos.jsp"><i class="bi bi-file-earmark-text"></i> Formatos</a></li>
        </c:if>
        <c:if test="${esEstudiante}">
          <li class="nav-item"><a class="nav-link" href="${ctx}/estudiante/panel.jsp"><i class="bi bi-person-workspace"></i> Mi trabajo</a></li>
        </c:if>
        <c:if test="${esDocente}">
          <li class="nav-item"><a class="nav-link" href="${ctx}/docente/panel.jsp"><i class="bi bi-person-badge"></i> Docente</a></li>
          <li class="nav-item"><a class="nav-link" href="${ctx}/docente/revisiones.jsp"><i class="bi bi-clipboard-check"></i> Revisiones</a></li>
        </c:if>
        <c:if test="${esComite}">
          <li class="nav-item"><a class="nav-link" href="${ctx}/comite/panel.jsp"><i class="bi bi-people"></i> Comit&eacute;</a></li>
        </c:if>
        <c:if test="${esAdmin}">
          <li class="nav-item"><a class="nav-link" href="${ctx}/admin/usuarios.jsp"><i class="bi bi-shield-lock"></i> Administraci&oacute;n</a></li>
        </c:if>
      </ul>
      <c:choose>
        <c:when test="${not empty sessionScope.idUsuario}">
          <span class="navbar-text text-white me-3">
            <i class="bi bi-person-circle"></i> <c:out value="${sessionScope.nombre}"/>
          </span>
          <a class="btn btn-outline-light btn-sm me-2" href="${ctx}/cuenta.jsp"><i class="bi bi-key"></i></a>
          <a class="btn btn-warning btn-sm" href="${ctx}/logout.jsp"><i class="bi bi-box-arrow-right"></i> Salir</a>
        </c:when>
        <c:otherwise>
          <a class="btn btn-warning btn-sm" href="${ctx}/login.jsp"><i class="bi bi-box-arrow-in-right"></i> Ingresar</a>
        </c:otherwise>
      </c:choose>
    </div>
  </div>
</nav>
<main class="container my-4">
<c:if test="${not empty param.ok}">
  <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle"></i>
    <c:out value="${param.ok}"/><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
</c:if>
<c:if test="${not empty param.err}">
  <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle"></i>
    <c:out value="${param.err}"/><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
</c:if>
